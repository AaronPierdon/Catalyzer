<Project Sdk="Microsoft.NET.Sdk">
  <!-- Catalyzer: a project command center. Every repo under your projects folder as a live card (git state, activity,
       one-click folder / GitHub / VS Code / Visual Studio / terminal + the project's own actions from its catalyzer.json).
       The base app has its own theme layer and controls; everything else (the Nexus look, more actions, more project
       sources, more themes) comes from plugins built against Catalyzer.Sdk. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Catalyzer</AssemblyName>
    <RootNamespace>Catalyzer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\catalyzer.ico</ApplicationIcon>
    <Product>Catalyzer</Product>
    <AssemblyTitle>Catalyzer</AssemblyTitle>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Catalyzer.Sdk\Catalyzer.Sdk.csproj" />
    <Resource Include="Assets\catalyzer.ico" />
  </ItemGroup>
</Project>
